{
    "name": "@brew-kit/devvit-client",
    "version": "0.0.0",
    "description": "Tailwind theme and React UI components for Devvit apps",
    "license": "BSD-3-Clause",
    "author": "Beach-Brews",
    "repository": {
        "type": "git",
        "url": "git+ssh://git@github.com/Beach-Brews/brew-kit-devvit.git",
        "directory": "packages/devvit-client"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/Beach-Brews"
        }
    ],
    "keywords": [
        "devvit",
        "reddit",
        "react",
        "tailwindcss",
        "components"
    ],
    "type": "module",
    "sideEffects": [
        "**/*.css"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./theme.css": "./dist/theme.css",
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "vite build --watch",
        "build": "vite build && tsc -p tsconfig.build.json",
        "typecheck": "tsc --noEmit",
        "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "tailwindcss": "^4.0.0"
    },
    "devDependencies": {
        "@types/react": "^19.3.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "tailwindcss": "^4.3.3"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@heroicons/react": "^2.2.0"
    }
}
