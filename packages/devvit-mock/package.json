{
    "name": "@brew-kit/devvit-mock",
    "version": "0.0.0",
    "description": "Mocks of Devvit APIs for local Vite development and Vitest",
    "license": "BSD-3-Clause",
    "author": "Beach-Brews",
    "repository": {
        "type": "git",
        "url": "git+ssh://git@github.com/Beach-Brews/brew-kit-devvit.git",
        "directory": "packages/devvit-mock"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/Beach-Brews"
        }
    ],
    "keywords": [
        "devvit",
        "reddit",
        "mock",
        "vite",
        "vitest"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        "./client": {
            "types": "./dist/client/index.d.ts",
            "import": "./dist/client/index.js"
        },
        "./server": {
            "types": "./dist/server/index.d.ts",
            "import": "./dist/server/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "vite build && tsc -p tsconfig.build.json",
        "dev": "vite build --watch --no-emptyOutDir",
        "typecheck": "tsc --noEmit",
        "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
    },
    "peerDependencies": {
        "@devvit/web": "^0.14.0"
    },
    "devDependencies": {
        "@devvit/web": "^0.14.6"
    },
    "publishConfig": {
        "access": "public"
    }
}
