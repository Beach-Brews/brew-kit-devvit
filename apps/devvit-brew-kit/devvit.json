{
    "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
    "name": "devvit-brew-kit",
    "post": {
        "dir": "dist/client",
        "entrypoints": {
            "default": {
                "inline": true,
                "entry": "index.html"
            }
        }
    },
    "server": {
        "dir": "dist/server",
        "entry": "index.cjs"
    },
    "menu": {
        "items": [
            {
                "label": "Create Brew-Kit Demo",
                "description": "devvit-brew-kit",
                "location": "subreddit",
                "forUserType": "moderator",
                "endpoint": "/internal/menu/post-create"
            }
        ]
    },
    "triggers": {
        "onAppInstall": "/internal/triggers/on-app-install"
    },
    "scripts": {
        "dev": "vite build --watch",
        "build": "vite build"
    }
}
